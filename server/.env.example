# Copy to .env and fill in. Never commit .env.

# The address your devices will use, without https://
DOMAIN=sync.example.com

# Set to "none" if you already run your own reverse proxy (Caddy, nginx, Traefik)
# and will point it at 127.0.0.1:FLOWLITE_PORT yourself.
HTTPS=caddy
FLOWLITE_PORT=8090

# Admin account for the PocketBase dashboard at https://DOMAIN/_/
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=choose-a-long-password

# The login you type into the FlowLite app
FLOWLITE_EMAIL=you@example.com
FLOWLITE_PASSWORD=choose-another-long-password
